<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    tools:context=".activities.SummaryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registration Summary Report"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Search / Filter Layout for Individual Student -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Individual Student"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etSearchStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Student ID or Reg Number"
                    android:inputType="text"
                    android:backgroundTint="@color/primary_blue"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_muted"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnViewIndividual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Individual Summary"
                    android:backgroundTint="@color/primary_blue"
                    android:textColor="@color/card_white" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- View All Button -->
        <Button
            android:id="@+id/btnViewAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View All Registered Students"
            android:backgroundTint="@color/primary_blue"
            android:textColor="@color/card_white"
            android:layout_marginBottom="16dp" />

        <!-- Summary Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report Details"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvSummaryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No report selected. Choose an option above to view summary."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:minHeight="150dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Print / View PDF Button -->
        <Button
            android:id="@+id/btnPrintReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Print / Export Report to PDF"
            android:backgroundTint="@color/accent_sky_blue"
            android:textColor="@color/card_white"
            android:layout_marginBottom="12dp" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:backgroundTint="@color/text_muted"
            android:textColor="@color/card_white" />

    </LinearLayout>
</ScrollView>
